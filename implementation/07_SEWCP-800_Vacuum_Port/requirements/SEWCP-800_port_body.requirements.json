{
  "package_id": "SEWCP-800-REQ-001",
  "component": "SEWCP-800_PORT_BODY",
  "authority": [
    "spec/07_SEWCP-800_Vacuum_Port.md Rev A (FROZEN) - VP-D01..VP-D08, VP-D11..VP-D14, section 5.1 (316L port body), VP-IF-1/VP-IF-2",
    "spec/01_SEWCP-200_Cooling_Plate.md CP-IF-5 (O10.0 H8 pilot bore, 4x M4 at O38 BC - verified in the SEWCP-200 model)"
  ],
  "scope": {
    "document_name": "SEWCP-800_PORT_BODY",
    "units": "mm",
    "bounded": "The 316L port body: O50 x 10 flange, O9.90 h8 x 8.00 pilot spigot, O4.00 H9 flow bore through spigot and flange, O24.50 mean face-seal groove in the flange top face, 4x O4.5 bolt holes at O38 BC, O6.35 x 1.00 wall x 100 tube stub with its stock bore, O6.00 H7 orifice seat. Datum: Z=0 at the flange top (plate-mating) face.",
    "modelling_conventions": "Bolt holes clock 45+n*90, matching the plate's CP-IF-5 tap clocking chosen under FBA-5. The orifice seat is modelled 5.0 deep at the tube free end (restrictor seats at the accessible end - agent decision, recorded). VP-D09 groove corner radii, VP-D10 flatness and weld details are drawing/inspection callouts.",
    "open_state": "No dependency on ECR-Q-011, the path-length item, or CP-02."
  },

  "parameters": [
    {"name": "vp_flange_d", "expression": "50.0", "unit": "mm", "source": "VP-D01"},
    {"name": "vp_flange_h", "expression": "10.0", "unit": "mm", "source": "VP-D02"},
    {"name": "vp_spigot_d", "expression": "9.9", "unit": "mm", "source": "VP-D03 h8"},
    {"name": "vp_spigot_l", "expression": "8.0", "unit": "mm", "source": "VP-D04"},
    {"name": "vp_bore_d", "expression": "4.0", "unit": "mm", "source": "VP-D05 H9"},
    {"name": "vp_groove_mean", "expression": "24.5", "unit": "mm", "source": "VP-D06"},
    {"name": "vp_groove_w", "expression": "3.2", "unit": "mm", "source": "VP-D07"},
    {"name": "vp_groove_dep", "expression": "1.9", "unit": "mm", "source": "VP-D08"},
    {"name": "vp_bolt_d", "expression": "4.5", "unit": "mm", "source": "VP-D11"},
    {"name": "vp_bolt_bc", "expression": "38.0", "unit": "mm", "source": "VP-D11; CP-IF-5"},
    {"name": "vp_tube_od", "expression": "6.35", "unit": "mm", "source": "VP-D13"},
    {"name": "vp_tube_wall", "expression": "1.0", "unit": "mm", "source": "VP-D13"},
    {"name": "vp_tube_id", "expression": "vp_tube_od - 2 * vp_tube_wall", "unit": "mm", "source": "VP-D13, derived = 4.35"},
    {"name": "vp_tube_l", "expression": "100.0", "unit": "mm", "source": "VP-D14"},
    {"name": "vp_seat_d", "expression": "6.0", "unit": "mm", "source": "VP-D12 H7"},
    {"name": "vp_seat_dep", "expression": "5.0", "unit": "mm", "source": "agent decision - restrictor length convention"}
  ],

  "material": {
    "name": "Stainless Steel",
    "density": 8000,
    "source": "spec/07 section 5.1 - 316L"
  },

  "requirements": [
    {"id": "VP-SPIGOT", "kind": "geometry",
     "statement": "O9.90 h8 pilot spigot, 8.00 long, above the flange face - aligns the port to the plate's O10.0 H8 bore.",
     "source": "spec/07 VP-D03/VP-D04; spec/01 CP-IF-5", "unit": "mm",
     "value": {"form": "disc", "plane": "XY", "sketch": "V1_SPIGOT",
       "diameter": "vp_spigot_d", "thickness": "vp_spigot_l",
       "direction": "positive", "operation": "new_body", "body": "VP_BODY"}},
    {"id": "VP-FLANGE", "kind": "geometry",
     "statement": "O50 x 10 flange below the mating face.",
     "source": "spec/07 VP-D01/VP-D02", "unit": "mm",
     "value": {"form": "disc", "plane": "XY", "sketch": "V2_FLANGE",
       "diameter": "vp_flange_d", "thickness": "vp_flange_h",
       "direction": "negative", "operation": "join"}},
    {"id": "VP-TUBE-PLANE", "kind": "interface",
     "statement": "Datum plane at the flange underside - the tube stub weld station.",
     "source": "spec/07 VP-D13", "unit": "mm",
     "value": {"form": "datum_plane", "name": "PL_TUBE", "base": "XY",
       "offset": "0 - vp_flange_h", "interface": null, "after": []}},
    {"id": "VP-TUBE", "kind": "geometry",
     "statement": "O6.35 x 1.00 wall tube stub, 100 long, below the flange.",
     "source": "spec/07 VP-D13/VP-D14", "unit": "mm",
     "value": {"form": "disc", "plane": "PL_TUBE", "sketch": "V3_TUBE",
       "diameter": "vp_tube_od", "thickness": "vp_tube_l",
       "direction": "negative", "operation": "join",
       "after": ["thermal.VP-TUBE-PLANE.plane"]}},
    {"id": "VP-BORE", "kind": "geometry",
     "statement": "O4.00 H9 flow bore through spigot and flange.",
     "source": "spec/07 VP-D05", "unit": "mm",
     "value": {"form": "axial_hole_pattern", "sketch": "V4_BORE",
       "diameter": "vp_bore_d", "depth": "2 * (vp_spigot_l + vp_flange_h)",
       "direction": "symmetric",
       "positions": {"points": [{"radius": "0", "azimuth": "0"}]},
       "after": ["mech.VP-TUBE.extrude"]}},
    {"id": "VP-TUBE-ID", "kind": "geometry",
     "statement": "The tube stub carries its stock bore (derived O4.35) for its full length, continuous with the flow bore.",
     "source": "spec/07 VP-D13", "unit": "mm",
     "value": {"form": "axial_hole_pattern", "sketch": "V5_TUBE_ID",
       "plane": "PL_TUBE", "plane_z": "0 - vp_flange_h",
       "diameter": "vp_tube_id", "depth": "vp_tube_l",
       "direction": "negative",
       "positions": {"points": [{"radius": "0", "azimuth": "0"}]},
       "after": ["mech.VP-BORE.cut"]}},
    {"id": "VP-SEAT-PLANE", "kind": "interface",
     "statement": "Datum plane at the tube free end - orifice seat station.",
     "source": "spec/07 VP-D12", "unit": "mm",
     "value": {"form": "datum_plane", "name": "PL_TUBE_END", "base": "XY",
       "offset": "0 - (vp_flange_h + vp_tube_l)", "interface": null, "after": []}},
    {"id": "VP-SEAT", "kind": "geometry",
     "statement": "O6.00 H7 orifice seat bore, 5.0 deep, at the tube free end.",
     "source": "spec/07 VP-D12", "unit": "mm",
     "value": {"form": "axial_hole_pattern", "sketch": "V6_SEAT",
       "plane": "PL_TUBE_END", "plane_z": "0 - (vp_flange_h + vp_tube_l)",
       "diameter": "vp_seat_d", "depth": "vp_seat_dep",
       "direction": "positive",
       "positions": {"points": [{"radius": "0", "azimuth": "0"}]},
       "after": ["mech.VP-TUBE-ID.cut", "thermal.VP-SEAT-PLANE.plane"]}},
    {"id": "VP-BOLTS", "kind": "geometry",
     "statement": "4x O4.5 bolt clearance holes at O38 BC, through the flange, clocked 45+n*90 to match the plate taps.",
     "source": "spec/07 VP-D11; spec/01 CP-IF-5", "unit": "mm",
     "value": {"form": "axial_hole_pattern", "sketch": "V7_BOLTS",
       "diameter": "vp_bolt_d", "depth": "vp_flange_h",
       "direction": "negative",
       "positions": {"bolt_circle_diameter": "vp_bolt_bc",
         "azimuth_start": "45", "azimuth_step": "90", "count": 4},
       "after": ["mech.VP-FLANGE.extrude"]}},
    {"id": "VP-GROOVE", "kind": "geometry",
     "statement": "Face-seal O-ring groove in the flange top face: O24.50 mean, 3.20 wide, 1.90 deep - the groove is in this 316L body, never in the aluminium plate.",
     "source": "spec/07 VP-D06/VP-D07/VP-D08, section 12; VP-IF-2", "unit": "mm",
     "value": {"form": "ring_groove", "sketch": "V8_GROOVE", "plane": "XY",
       "mean_diameter": "vp_groove_mean", "groove_width": "vp_groove_w",
       "depth": "vp_groove_dep", "direction": "negative",
       "after": ["mech.VP-BOLTS.cut"]}},
    {"id": "MFG-VP", "kind": "manufacturing",
     "statement": "316L body; tube stub orbital-welded; groove corners R0.3 max (VP-D09), sealing face 0.010 TIR lapped (VP-D10).",
     "source": "spec/07 sections 5.1/12"}
  ],

  "interfaces": [
    {"id": "VP-IF-1", "mates_to": "SEWCP-200 Cooling Plate", "nature": "O9.90 h8 spigot in the O10.0 H8 bore; 4x M4 x 16 SHCS at O38 BC (plate taps verified)", "source": "spec/07 VP-IF-1; spec/01 CP-IF-5"},
    {"id": "VP-IF-2", "mates_to": "FKM O-ring 22.0 ID x 2.50 CS", "nature": "Face seal in this body's groove", "source": "spec/07 VP-IF-2"}
  ],

  "acceptance": [
    {"id": "ACC-UNITS", "check": "constraint", "subject": "document.units", "expect": "mm"},
    {"id": "ACC-NAME", "check": "constraint", "subject": "component.name", "expect": "SEWCP-800_PORT_BODY"},
    {"id": "ACC-PARAM-COUNT", "check": "parameter", "subject": "parameters.count", "expect": 16},
    {"id": "ACC-TUBE-ID", "check": "parameter", "subject": "parameter:vp_tube_id.value", "expect": 4.35, "tolerance": 1e-06, "requirement": "VP-TUBE-ID"},
    {"id": "ACC-TUBE-ID-DERIVED", "check": "constraint", "subject": "parameter:vp_tube_id.is_derived", "expect": true},
    {"id": "ACC-GROOVE-MEAN", "check": "parameter", "subject": "parameter:vp_groove_mean.value", "expect": 24.5, "tolerance": 1e-06, "requirement": "VP-GROOVE"},
    {"id": "ACC-PL-TUBE", "check": "interface", "subject": "plane:PL_TUBE.offset_mm", "expect": -10.0, "tolerance": 0.0001, "requirement": "VP-TUBE-PLANE"},
    {"id": "ACC-PL-END", "check": "interface", "subject": "plane:PL_TUBE_END.offset_mm", "expect": -110.0, "tolerance": 0.0001, "requirement": "VP-SEAT-PLANE"},
    {"id": "ACC-SK-GROOVE", "check": "interface", "subject": "sketch:V8_GROOVE.exists", "expect": true, "requirement": "VP-GROOVE"},
    {"id": "ACC-BODY-COUNT", "check": "geometry", "subject": "bodies.count", "expect": 1},
    {"id": "ACC-BODY-DZ", "check": "geometry", "subject": "body:VP_BODY.dz", "expect": 118.0, "tolerance": 0.001, "requirement": "VP-TUBE"},
    {"id": "ACC-BODY-DX", "check": "geometry", "subject": "body:VP_BODY.dx", "expect": 50.0, "tolerance": 0.01, "requirement": "VP-FLANGE"},
    {"id": "ACC-BODY-DY", "check": "geometry", "subject": "body:VP_BODY.dy", "expect": 50.0, "tolerance": 0.01, "requirement": "VP-FLANGE"},
    {"id": "ACC-FEATURES", "check": "geometry", "subject": "features.count", "expect": 8}
  ]
}
