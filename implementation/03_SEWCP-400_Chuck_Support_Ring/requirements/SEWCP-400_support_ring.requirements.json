{
  "package_id": "SEWCP-400-REQ-001",
  "component": "SEWCP-400_SUPPORT_RING",
  "authority": [
    "spec/03_SEWCP-400_Chuck_Support_Ring.md Rev A (FROZEN) - SR-D01, SR-D05..SR-D20, section 4 (99.5% alumina, 3.0 wall set by grindability)",
    "spec/01_SEWCP-200_Cooling_Plate.md CP-IF-1/CP-IF-2 (locators and 8x M6 at O302 BC, 22.5+n*45 - verified in the SEWCP-200 model)"
  ],
  "scope": {
    "document_name": "SEWCP-400_SUPPORT_RING",
    "units": "mm",
    "bounded": "The alumina I-section ring, as supplied (20.300 with DR-3 lap stock): flanges O286-O318 x 3.15 each, web O294-O300 x 14.00, 16x O7.0 bolt holes (8 per flange, O302 BC), 3x kinematic slots 6.05 x 8.00 x 3.00 at O306 BC in the top flange, clamp register rebate O285.5-O318.5 x 0.50 in the bottom face.",
    "modelling_conventions": "DECISIONS (design agent): the 0.300 lap stock splits 0.15 per flange (3.15 each, web 14.00 exact - SR-D08 governs the web; DR-3 lap removes flange stock). Both hole patterns clock 22.5+n*45 matching CP-IF-2. Slots clock 60/180/300 receiving the plate's bottom locators. R3 fillets (SR-D12) and 0.3 x 45 chamfers (SR-D15/D21) are ground edge features deferred to the drawing per convention.",
    "open_state": "No dependency on ECR-Q-011, the path-length item, or CP-02."
  },

  "parameters": [
    {"name": "sr_h_supplied", "expression": "20.3", "unit": "mm", "source": "SR-D01"},
    {"name": "sr_web_od", "expression": "300.0", "unit": "mm", "source": "SR-D05"},
    {"name": "sr_web_id", "expression": "294.0", "unit": "mm", "source": "SR-D06"},
    {"name": "sr_web_h", "expression": "14.0", "unit": "mm", "source": "SR-D08"},
    {"name": "sr_fl_od", "expression": "318.0", "unit": "mm", "source": "SR-D09"},
    {"name": "sr_fl_id", "expression": "286.0", "unit": "mm", "source": "SR-D10"},
    {"name": "sr_fl_h", "expression": "(sr_h_supplied - sr_web_h) / 2", "unit": "mm", "source": "derived = 3.15: SR-D11 3.00 + half the DR-3 lap stock"},
    {"name": "sr_bolt_d", "expression": "7.0", "unit": "mm", "source": "SR-D13"},
    {"name": "sr_bolt_bc", "expression": "302.0", "unit": "mm", "source": "SR-D14"},
    {"name": "sr_slot_w", "expression": "6.05", "unit": "mm", "source": "SR-D17 H8"},
    {"name": "sr_slot_l", "expression": "8.0", "unit": "mm", "source": "SR-D18"},
    {"name": "sr_slot_dep", "expression": "3.0", "unit": "mm", "source": "SR-D19"},
    {"name": "sr_slot_bc", "expression": "306.0", "unit": "mm", "source": "SR-D20"},
    {"name": "sr_reg_od", "expression": "318.5", "unit": "mm", "source": "SR-D16"},
    {"name": "sr_reg_id", "expression": "285.5", "unit": "mm", "source": "SR-D16"},
    {"name": "sr_reg_dep", "expression": "0.5", "unit": "mm", "source": "SR-D16"}
  ],

  "material": {
    "name": "Aluminum Oxide",
    "density": 3900,
    "source": "spec/03 section 4 - 99.5% alumina"
  },

  "requirements": [
    {"id": "SR-BFLANGE", "kind": "geometry",
     "statement": "Bottom flange annulus O286-O318 x 3.15 (with lap stock).",
     "source": "spec/03 SR-D09/SR-D10/SR-D11", "unit": "mm",
     "value": {"form": "ring_groove", "sketch": "G1_BFL", "plane": "XY",
       "mean_diameter": "(sr_fl_od + sr_fl_id) / 2",
       "groove_width": "(sr_fl_od - sr_fl_id) / 2",
       "depth": "sr_fl_h", "direction": "positive",
       "operation": "new_body", "body": "SR_BODY"}},
    {"id": "SR-WEB-PLANE", "kind": "interface",
     "statement": "Web start datum at the top of the bottom flange.",
     "source": "spec/03 SR-D08", "unit": "mm",
     "value": {"form": "datum_plane", "name": "PL_WEB", "base": "XY",
       "offset": "sr_fl_h", "interface": null, "after": []}},
    {"id": "SR-WEB", "kind": "geometry",
     "statement": "Web annulus O294-O300 x 14.00 - the 3.00 wall set by alumina grindability, the thermal/electrical break.",
     "source": "spec/03 SR-D05..SR-D08", "unit": "mm",
     "value": {"form": "ring_groove", "sketch": "G2_WEB", "plane": "PL_WEB",
       "plane_z": "sr_fl_h",
       "mean_diameter": "(sr_web_od + sr_web_id) / 2",
       "groove_width": "(sr_web_od - sr_web_id) / 2",
       "depth": "sr_web_h", "direction": "positive", "operation": "join",
       "after": ["thermal.SR-WEB-PLANE.plane"]}},
    {"id": "SR-TFL-PLANE", "kind": "interface",
     "statement": "Top flange start datum.",
     "source": "spec/03 SR-D01", "unit": "mm",
     "value": {"form": "datum_plane", "name": "PL_TFL", "base": "XY",
       "offset": "sr_fl_h + sr_web_h", "interface": null, "after": []}},
    {"id": "SR-TFLANGE", "kind": "geometry",
     "statement": "Top flange annulus O286-O318 x 3.15 - mates the Cooling Plate bottom face.",
     "source": "spec/03 SR-D09..SR-D11; spec/01 CP-IF-1/CP-IF-2", "unit": "mm",
     "value": {"form": "ring_groove", "sketch": "G3_TFL", "plane": "PL_TFL",
       "plane_z": "sr_fl_h + sr_web_h",
       "mean_diameter": "(sr_fl_od + sr_fl_id) / 2",
       "groove_width": "(sr_fl_od - sr_fl_id) / 2",
       "depth": "sr_fl_h", "direction": "positive", "operation": "join",
       "after": ["thermal.SR-TFL-PLANE.plane"]}},
    {"id": "SR-BOLT-B", "kind": "geometry",
     "statement": "8x O7.0 bolt clearance holes in the bottom flange, O302 BC at 22.5+n*45.",
     "source": "spec/03 SR-D13/SR-D14", "unit": "mm",
     "value": {"form": "axial_hole_pattern", "sketch": "G4_BOLT_B",
       "diameter": "sr_bolt_d", "depth": "sr_fl_h",
       "positions": {"bolt_circle_diameter": "sr_bolt_bc",
         "azimuth_start": "22.5", "azimuth_step": "45", "count": 8},
       "after": ["mech.SR-TFLANGE.cut"]}},
    {"id": "SR-BOLT-T", "kind": "geometry",
     "statement": "8x O7.0 bolt clearance holes in the top flange, O302 BC at 22.5+n*45 - the upper fastening circuit into the plate's M6 taps.",
     "source": "spec/03 SR-D13/SR-D14; spec/01 CP-IF-2", "unit": "mm",
     "value": {"form": "axial_hole_pattern", "sketch": "G5_BOLT_T",
       "plane": "PL_TFL", "plane_z": "sr_fl_h + sr_web_h",
       "diameter": "sr_bolt_d", "depth": "sr_fl_h", "direction": "positive",
       "positions": {"bolt_circle_diameter": "sr_bolt_bc",
         "azimuth_start": "22.5", "azimuth_step": "45", "count": 8},
       "after": ["mech.SR-BOLT-B.cut"]}},
    {"id": "SR-SLOTS", "kind": "geometry",
     "statement": "3x radial kinematic slots 6.05 W x 8.00 L x 3.00 D at O306 BC, 60/180/300, in the top face - receiving the plate's bottom locator bosses.",
     "source": "spec/03 SR-D17..SR-D20; spec/01 CP-IF-1", "unit": "mm",
     "value": {"form": "slot_pattern", "sketch": "G6_SLOTS",
       "width": "sr_slot_w", "length": "sr_slot_l", "depth": "sr_slot_dep",
       "direction": "negative", "plane": "PL_TOP_FACE",
       "positions": {"bolt_circle_diameter": "sr_slot_bc",
         "azimuths": ["60", "180", "300"]},
       "after": ["mech.SR-BOLT-T.cut", "thermal.SR-TOP-PLANE.plane"]}},
    {"id": "SR-TOP-PLANE", "kind": "interface",
     "statement": "The as-supplied top face datum at 20.300.",
     "source": "spec/03 SR-D01", "unit": "mm",
     "value": {"form": "datum_plane", "name": "PL_TOP_FACE", "base": "XY",
       "offset": "sr_h_supplied", "interface": "CP-IF-1", "after": []}},
    {"id": "SR-REGISTER", "kind": "geometry",
     "statement": "SR-D16 clamp register: NOT MODELLED. As tabulated (O285.5/O318.5 x 0.50) the counterbore envelope exceeds the flange band on both edges, so cutting it removes the entire bottom datum face by 0.50 - geometrically degenerate on this part. The register almost certainly belongs to the mating clamp ring; carried as a drawing-stage clarification (candidate ECR-Q against spec/03), not silently reinterpreted.",
     "source": "spec/03 SR-D16"},
    {"id": "MFG-SR", "kind": "manufacturing",
     "statement": "Ground 99.5% alumina; DR-3 assembly lap to height; all edges 0.3 x 45 min against chipping; R3 web fillets ground.",
     "source": "spec/03 sections 4/6"}
  ],

  "interfaces": [
    {"id": "SR-IF-1", "mates_to": "SEWCP-200 Cooling Plate", "nature": "Top flange: 3x kinematic slots + 8x M6 upper circuit (plate side verified)", "source": "spec/01 CP-IF-1/CP-IF-2"},
    {"id": "SR-IF-2", "mates_to": "Base Plate / clamp ring", "nature": "Bottom flange + register rebate", "source": "spec/03 SR-D16"}
  ],

  "acceptance": [
    {"id": "ACC-UNITS", "check": "constraint", "subject": "document.units", "expect": "mm"},
    {"id": "ACC-NAME", "check": "constraint", "subject": "component.name", "expect": "SEWCP-400_SUPPORT_RING"},
    {"id": "ACC-PARAM-COUNT", "check": "parameter", "subject": "parameters.count", "expect": 16},
    {"id": "ACC-FL-H", "check": "parameter", "subject": "parameter:sr_fl_h.value", "expect": 3.15, "tolerance": 1e-06, "requirement": "SR-BFLANGE"},
    {"id": "ACC-FL-H-DERIVED", "check": "constraint", "subject": "parameter:sr_fl_h.is_derived", "expect": true},
    {"id": "ACC-PL-TOP", "check": "interface", "subject": "plane:PL_TOP_FACE.offset_mm", "expect": 20.3, "tolerance": 0.0001, "requirement": "SR-TOP-PLANE"},
    {"id": "ACC-BODY-COUNT", "check": "geometry", "subject": "bodies.count", "expect": 1},
    {"id": "ACC-BODY-DZ", "check": "geometry", "subject": "body:SR_BODY.dz", "expect": 20.3, "tolerance": 0.001, "requirement": "SR-BFLANGE"},
    {"id": "ACC-BODY-DX", "check": "geometry", "subject": "body:SR_BODY.dx", "expect": 318.0, "tolerance": 0.01, "requirement": "SR-BFLANGE"},
    {"id": "ACC-BODY-DY", "check": "geometry", "subject": "body:SR_BODY.dy", "expect": 318.0, "tolerance": 0.01, "requirement": "SR-BFLANGE"},
    {"id": "ACC-FEATURES", "check": "geometry", "subject": "features.count", "expect": 6},
    {"id": "ACC-SK-SLOTS", "check": "interface", "subject": "sketch:G6_SLOTS.exists", "expect": true, "requirement": "SR-SLOTS"},
    {"id": "ACC-MASS", "check": "mass", "subject": "body:SR_BODY.mass_kg", "expect": 0.5175, "tolerance": 0.02, "requirement": "MFG-SR"}
  ]
}
